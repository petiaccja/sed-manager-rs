{
  "name": "Rust",
  "image": "mcr.microsoft.com/devcontainers/rust",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "./features/apt-packages": {
      "packages": "libx11-xcb1 libxcb1 libxkbcommon0 libinput10 libgbm1"
    },
    "./features/owned-paths": {
      "username": "vscode",
      "paths": "/home/vscode/.claude"
    },
    "./features/egress-firewall": {}
  },
  "containerUser": "root",
  "remoteUser": "vscode",
  "runArgs": [
    "--name=${localWorkspaceFolderBasename}-dev"
  ],
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspaces/${localWorkspaceFolderBasename}/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.git/hooks,target=/workspaces/${localWorkspaceFolderBasename}/.git/hooks,type=bind,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "${localEnv:OTEL_EXPORTER_OTLP_PROTOCOL}",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${localEnv:OTEL_EXPORTER_OTLP_ENDPOINT_DEVCONTAINER}",
    "OTEL_EXPORTER_OTLP_HEADERS": "${localEnv:OTEL_EXPORTER_OTLP_HEADERS}",
    "EGRESS_ALLOW_URLS": "${localEnv:OTEL_EXPORTER_OTLP_ENDPOINT_DEVCONTAINER}"
  },
  "postCreateCommand": "cargo install licensesnip"
}
