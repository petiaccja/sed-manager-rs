import { AccessControl } from "../data/device.slint";

// See the Rust code for documentation.
export global AccessControlLib {
    pure callback is-any-dirty(access-control: AccessControl) -> bool;
    pure callback discard(access-control: AccessControl) -> bool;

    is-any-dirty => { true }
    discard => { false }
}
