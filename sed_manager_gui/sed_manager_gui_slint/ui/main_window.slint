import { Logo } from "resources/logo.slint";
import { Device, Outcome } from "data/lib.slint";
import {
    TabWidget,
    Palette,
    Spinner,
    StyleMetrics,
} from "std-widgets.slint";
import {
    DeviceView,
    DeviceSideBar,
    DeviceSwitchView,
    DeviceScanButton,
} from "views/lib.slint";
import { TestData } from "data/lib.slint";
import {
    ToastQueue,
    ToastArea,
    ToastLevel,
} from "widgets/lib.slint";
import { MainWindowGeometry } from "main_window_geometry.slint";

export { ToastQueue } from "widgets/lib.slint";
export { SectorLib } from "algorithm/sector.slint";
export { LockingRangeLib } from "algorithm/locking_range.slint";
export { AuthorityLib } from "algorithm/authority.slint";
export { AccessControlLib } from "algorithm/access_control.slint";

export component MainWindow inherits Window {
    title: "SED Manager";
    icon: Logo.png;
    preferred-width: 1154px;
    preferred-height: 720px;

    in-out property <[Device]> devices: TestData.devices;
    in property <Outcome> scan-outcome: Outcome.success;
    in property <bool> is-quitting: false;

    callback scan <=> scan-button.clicked;
    callback close-device <=> side-bar.close-device;
    callback take-owneship <=> device-switch-view.take-owneship;
    callback activate-locking <=> device-switch-view.activate-locking;
    callback change-password <=> device-switch-view.change-password;
    callback list-admin-authorities <=> device-switch-view.list-admin-authorities;
    callback list-locking-authorities <=> device-switch-view.list-locking-authorities;
    callback login <=> device-switch-view.login;
    callback logout <=> device-switch-view.logout;
    callback commit-locking-ranges <=> device-switch-view.commit-locking-ranges;
    callback erase-locking-range <=> device-switch-view.erase-locking-range;
    callback commit-authorities <=> device-switch-view.commit-authorities;
    callback change-locking-password <=> device-switch-view.change-locking-password;
    callback commit-mbr-control <=> device-switch-view.commit-mbr-control;
    callback write-mbr <=> device-switch-view.write-mbr;
    callback pick-and-write-mbr <=> device-switch-view.pick-and-write-mbr;
    callback cancel-mbr-write <=> device-switch-view.cancel-mbr-write;
    callback revert-device <=> device-switch-view.revert-device;
    callback query-stack-status <=> device-switch-view.query-stack-status;
    callback reset-stack <=> device-switch-view.reset-stack;

    changed width => { MainWindowGeometry.width = self.width; }
    changed height => { MainWindowGeometry.height = self.height; }

    HorizontalLayout {
        padding: 1.0rem;
        spacing: 1.6rem;

        side-bar := DeviceSideBar {
            devices: devices;
            max-width: 22rem;
            horizontal-stretch: 0.2;
        }

        device-switch-view := DeviceSwitchView {
            selected: side-bar.selected;
            devices <=> devices;
            horizontal-stretch: 1.0;
        }
    }

    scan-button := DeviceScanButton {
        x: side-bar.x;
        y: side-bar.y + side-bar.height - self.height;
        z: 1;
        outcome: scan-outcome;
    }

    ToastArea {
        x: 1rem;
        y: 1rem;
        z: 2;
        width: 20rem;
        height: parent.height - 2 * self.y;
    }

    if is-quitting: Rectangle {
        background: Palette.background;
        opacity: 90%;
        z: 3;

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                spacing: StyleMetrics.layout-spacing;

                Spinner {
                    indeterminate: true;
                    height: 8rem;
                }

                Text {
                    text: "Closing all devices...";
                    font-size: 1.4rem;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
