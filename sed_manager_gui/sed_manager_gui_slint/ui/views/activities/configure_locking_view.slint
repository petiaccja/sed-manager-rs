import {
    ToastCard,
    ToastLevel,
    PaletteExtra,
} from "../../widgets/lib.slint";
import {
    CommandStatus,
    SecurityProvider,
    LockingRange,
    Sector,
    Uid,
    Alignment,
    Geometry,
} from "../../data/lib.slint";
import {
    TabWidget,
    ScrollView,
    LineEdit,
    CheckBox,
    Palette,
    Button,
    StyleMetrics,
} from "std-widgets.slint";
import { LockingRangesTab } from "locking/locking_ranges.slint";
import { AuthoritiesTab } from "locking/authorities.slint";
import { ShadowMbrTab } from "locking/shadow_mbr.slint";
import { LoginPanel } from "locking/login.slint";
import { Icons } from "../../resources/lib.slint";


export component ConfigureLockingView {
    in property <Geometry> geometry;
    in property <Alignment> alignment;
    in property <CommandStatus> command-status;
    in-out property <SecurityProvider> locking-sp;

    callback login(authority: Uid, password: string);
    callback logout();
    callback commit-locking-ranges();
    callback erase-locking-range(locking-range: Uid);
    callback commit-authorities();
    callback change-password(authority: Uid, password: string);
    callback commit-mbr-control();
    callback write-mbr(path: string);
    callback pick-and-write-mbr();
    callback cancel-mbr-write();

    if !command-status.secondary-session-active: VerticalLayout {
        alignment: start;
        HorizontalLayout {
            alignment: center;
            LoginPanel {
                preferred-width: 16rem;
                command-status: command-status;
                locking-sp: locking-sp;

                login(authority, password) => {
                    login(authority, password)
                }
            }
        }
    }

    if command-status.secondary-session-active: TabWidget {
        Tab {
            title: "Locking ranges";

            VerticalLayout {
                padding-top: StyleMetrics.layout-spacing;

                LockingRangesTab {
                    geometry: geometry;
                    alignment: alignment;
                    locking-ranges <=> locking-sp.locking-ranges;
                    command-status: command-status;

                    commit-locking-ranges => {
                        commit-locking-ranges()
                    }

                    erase-locking-range(locking-range) => {
                        erase-locking-range(locking-range)
                    }

                    logout() => {
                        logout()
                    }
                }
            }
        }

        Tab {
            title: "Authorities";

            VerticalLayout {
                padding-top: StyleMetrics.layout-spacing;

                AuthoritiesTab {
                    authorities <=> locking-sp.authorities;
                    command-status: command-status;
                    mbr: locking-sp.mbr;

                    commit-authorities => {
                        commit-authorities()
                    }

                    change-password(authority, password) => {
                        change-password(authority, password)
                    }

                    logout() => {
                        logout()
                    }
                }
            }
        }

        Tab {
            title: "Shadow MBR";

            VerticalLayout {
                padding-top: StyleMetrics.layout-spacing;

                ShadowMbrTab {
                    geometry: geometry;
                    command-status: command-status;
                    mbr <=> locking-sp.mbr;

                    commit-mbr-control() => {
                        commit-mbr-control()
                    }

                    write-mbr(path) => {
                        write-mbr(path)
                    }

                    pick-and-write-mbr() => {
                        pick-and-write-mbr()
                    }

                    cancel-mbr-write() => {
                        cancel-mbr-write()
                    }

                    logout() => {
                        logout()
                    }
                }
            }
        }
    }
}
