import {
    ScrollView,
    CheckBox,
    Button,
    Palette,
    GroupBox,
    StyleMetrics,
} from "std-widgets.slint";
import {
    Authority,
    Sector,
    CommandStatus,
    LockingRangeAccess,
    Mbr,
    MbrAccess,
} from "../../../data/lib.slint";
import {
    Detached,
    Cell,
    HeaderCell,
    PaletteExtra,
    CyclicColor,
    HorizontalSeparator,
    IslandButton,
    IconButton,
    ToastQueue,
    ToastLevel,
} from "../../../widgets/lib.slint";
import { Icons } from "../../../resources/lib.slint";
import { AuthorityLib } from "../../../algorithm/authority.slint";

component AuthorityTable {
    preferred-width: table.preferred-width;
    preferred-height: table.preferred-height;

    in-out property <[Authority]> authorities;

    viewport := ScrollView {
        GridLayout {
            Rectangle {
                background: PaletteExtra.separator.with-alpha(0.25);
                clip: true;
                border-radius: 0.6rem;
                border-width: 0.1rem;
                border-color: self.background;

                table := GridLayout {
                    spacing: 0.1rem;

                    Detached {
                        row: 0;
                        col: 0;
                        z: 2;
                        offset-x: -viewport.viewport-x;
                        offset-y: -viewport.viewport-y;
                        HeaderCell { }
                    }

                    for column[index] in [
                        "Common name",
                        "Enabled",
                    ]: Detached {
                        row: 0;
                        col: index + 1;
                        z: 1;
                        offset-y: -viewport.viewport-y;

                        HeaderCell {
                            Text {
                                text: column;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for authority[index] in authorities: Detached {
                        row: index + 1;
                        col: 0;
                        offset-x: -viewport.viewport-x;
                        z: 1;

                        HeaderCell {
                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: authority.name;
                                    color: {
                                        if authority.is-class {
                                            PaletteExtra.make-accented(#FFE000, Palette.control-foreground, Palette.control-background)
                                        } else if authority.is-admin {
                                            PaletteExtra.make-accented(#FF4000, Palette.control-foreground, Palette.control-background)
                                        } else if authority.has-password {
                                            PaletteExtra.make-accented(#0080FF, Palette.control-foreground, Palette.control-background)
                                        } else {
                                            Palette.control-foreground
                                        }
                                    };
                                    vertical-alignment: center;
                                    font-italic: AuthorityLib.is-individual-dirty(index, authorities);
                                }

                                if authority.has-password: IconButton {
                                    icon-size: 1.4rem;
                                    icon: Icons.change-password;
                                    text-placement: left;
                                }
                            }
                        }
                    }

                    for authority[index] in authorities: Detached {
                        row: index + 1;
                        col: 1;

                        Cell {
                            TextInput {
                                text <=> authority.common-name;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for authority[index] in authorities: Detached {
                        row: index + 1;
                        col: 2;

                        Cell {
                            CheckBox {
                                accessible-id: "authority-enabled-" + authority.name;
                                checked <=> authority.enabled;
                                enabled: !authority.is-class;
                            }
                        }
                    }
                }
            }
        }
    }
}


export component AuthoritiesTab {
    in-out property <[Authority]> authorities;
    in property <CommandStatus> command-status;
    in property <Mbr> mbr;

    callback commit-authorities();
    callback logout();

    VerticalLayout {
        alignment: space-between;
        spacing: StyleMetrics.layout-spacing;

        AuthorityTable {
            authorities <=> authorities;
        }

        HorizontalLayout {
            alignment: stretch;
            spacing: StyleMetrics.layout-spacing;

            Button {
                accessible-id: "save-authorities-submit";
                text: "Apply";
                primary: true;
                enabled: !command-status.session-busy && AuthorityLib.is-any-dirty(authorities);
                icon: Icons.check;
                colorize-icon: true;
                preferred-width: 7rem;

                clicked => {
                    commit-authorities();
                }
            }

            Button {
                accessible-id: "discard-authorities-submit";
                text: "Discard";
                enabled: AuthorityLib.is-any-dirty(authorities);
                icon: Icons.cancel;
                colorize-icon: true;
                preferred-width: 7rem;

                clicked => {
                    if !AuthorityLib.discard(authorities) {
                        ToastQueue.push({
                            level: ToastLevel.error,
                            title: "Could not discard changes",
                            message: "You won't be able to discard you changes, but you can keep working and save them. This is a bug, please report it.",
                        })
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 100%;
            }

            Button {
                text: "Logout";
                icon: Icons.logout;
                colorize-icon: true;
                preferred-width: 7rem;
                accessible-id: "logout-submit";

                clicked => {
                    logout();
                }
            }
        }
    }
}
