import {
    ScrollView,
    CheckBox,
    Button,
    Palette,
    GroupBox,
} from "std-widgets.slint";
import {
    User,
    Sector,
    SectorUtil,
    CommandStatus,
    LockingRangeAccess,
    Mbr,
    MbrAccess,
} from "../../../data/lib.slint";
import {
    Detached,
    Cell,
    HeaderCell,
    PaletteExtra,
    HorizontalSeparator,
    IslandButton,
} from "../../../widgets/lib.slint";

component UserInformation {
    in-out property <string> user-common-name;
    in-out property <bool> user-enabled;
    in property <bool> user-is-class;

    Rectangle {
        background: PaletteExtra.separator.with-alpha(0.25);
        clip: true;
        border-radius: 0.6rem;
        border-width: 0.1rem;
        border-color: self.background;

        table := GridLayout {
            spacing: 0.1rem;

            for column[index] in [
                "Common name",
                "Enabled",
                "Password",
                "Kind",
            ]: HeaderCell {
                row: index;
                col: 0;
                z: 1;

                Text {
                    width: self.min-width;
                    text: column;
                    vertical-alignment: center;
                }
            }

            Cell {
                row: 0;
                col: 1;

                TextInput {
                    text <=> user-common-name;
                }
            }

            Cell {
                row: 1;
                col: 1;

                HorizontalLayout {
                    alignment: start;

                    CheckBox {
                        checked <=> user-enabled;
                    }
                }
            }

            Cell {
                row: 2;
                col: 1;

                TextInput {
                    input-type: password;
                }
            }

            Cell {
                row: 3;
                col: 1;

                Text {
                    text: user-is-class ? "Class" : "Individual";
                }
            }
        }
    }
}

component MbrAccessTable {
    in-out property <MbrAccess> mbr-access;

    Rectangle {
        background: PaletteExtra.separator.with-alpha(0.25);
        clip: true;
        border-radius: 0.6rem;
        border-width: 0.1rem;
        border-color: self.background;

        HorizontalLayout {
            spacing: 0.1rem;

            HeaderCell {
                Text {
                    text: "Shadow MBR";
                }
            }

            Cell {
                horizontal-stretch: 1.0;
                HorizontalLayout {
                    allow-unshadow := CheckBox {
                        checked <=> mbr-access.set-done;
                        text: "Allow unshadow";
                    }
                }
            }
        }
    }
}

component LockingRangeAccessTable {
    preferred-width: table.preferred-width;
    preferred-height: table.preferred-height;

    in-out property <[LockingRangeAccess]> locking-ranges;

    viewport := ScrollView {
        GridLayout {
            Rectangle {
                background: PaletteExtra.separator.with-alpha(0.25);
                clip: true;
                border-radius: 0.6rem;
                border-width: 0.1rem;
                border-color: self.background;

                table := GridLayout {
                    spacing: 0.1rem;

                    Detached {
                        row: 0;
                        col: 0;
                        z: 2;
                        offset-x: -viewport.viewport-x;
                        offset-y: -viewport.viewport-y;
                        HeaderCell { }
                    }

                    for column[index] in [
                        "Allow read unlock",
                        "Allow write unlock",
                    ]: Detached {
                        row: 0;
                        col: index + 1;
                        z: 1;
                        offset-y: -viewport.viewport-y;

                        HeaderCell {
                            Text {
                                text: column;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 0;
                        offset-x: -viewport.viewport-x;
                        z: 1;

                        HeaderCell {
                            Text {
                                text: locking-range.name;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 1;

                        Cell {
                            horizontal-alignment: space-around;
                            CheckBox {
                                checked <=> locking-range.read-unlock;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 2;

                        Cell {
                            horizontal-alignment: space-around;
                            CheckBox {
                                checked <=> locking-range.write-unlock;
                            }
                        }
                    }
                }
            }
        }
    }
}

component UserSideBarItem inherits IslandButton {
    has-background: true;
    has-idle-background: false;

    in property <string> user-name;

    HorizontalLayout {
        padding-left: 0.8rem;
        padding-right: 0.8rem;
        padding-top: 0.6rem;
        padding-bottom: 0.6rem;

        Text {
            text: user-name;
            font-size: 1.2rem;
            font-weight: 600;
            overflow: elide;
            color: root.is-selected ? PaletteExtra.accented-control-foreground : root.foreground;
            vertical-alignment: center;
        }
    }
}

export component UserSideBar {
    height: 3.2rem;
    preferred-width: content.preferred-width;
    preferred-height: content.preferred-height;

    in property <[User]> users;
    in-out property <int> selected;

    ScrollView {
        vertical-scrollbar-policy: always-off;
        content := HorizontalLayout {
            alignment: start;
            spacing: 0.2rem;

            for user[index] in users: UserSideBarItem {
                is-selected: index == selected;
                user-name: user.name;

                clicked => {
                    root.selected = index
                }
            }
        }
    }
}

export component UserPanel {
    in-out property <User> user;
    in property <Mbr> mbr;

    VerticalLayout {
        alignment: start;

        GroupBox {
            title: "User information";

            UserInformation {
                user-common-name <=> user.common-name;
                user-enabled <=> user.enabled;
            }
        }

        GroupBox {
            title: "Access control";

            VerticalLayout {
                spacing: 1.2rem;

                if mbr.supported: MbrAccessTable {
                    mbr-access <=> user.mbr-access;
                }

                LockingRangeAccessTable {
                    min-height: self.preferred-height;
                    locking-ranges <=> user.locking-range-access;
                }
            }
        }
    }
}


export component UsersTab {
    in-out property <[User]> users;
    in property <CommandStatus> command-status;
    in property <Mbr> mbr;

    VerticalLayout {
        sidebar := UserSideBar {
            horizontal-stretch: 0.0;
            vertical-stretch: 0.0;
            users: users;
        }

        VerticalLayout {
            horizontal-stretch: 1.0;
            vertical-stretch: 1.0;
            alignment: start;

            ScrollView {
                preferred-width: content.preferred-width;
                min-width: content.min-width;
                preferred-height: content.preferred-height;
                horizontal-scrollbar-policy: always-off;

                content := VerticalLayout {
                    for user[index] in users: Rectangle {
                        visible: index == sidebar.selected;
                        preferred-height: index == sidebar.selected ? panel.preferred-height : 0;
                        min-height: index == sidebar.selected ? panel.min-height : 0;
                        VerticalLayout {
                            panel := UserPanel {
                                user <=> user;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1.2rem;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 0.8rem;

                Button {
                    text: "Save users";
                    width: 8rem;
                    primary: true;
                    enabled: !command-status.session-busy && !command-status.session-busy;
                }

                Button {
                    text: "Discard";
                    width: 8rem;
                }
            }
        }
    }
}
