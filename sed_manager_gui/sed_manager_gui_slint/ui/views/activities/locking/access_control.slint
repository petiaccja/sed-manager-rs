import { Button, StyleMetrics } from "std-widgets.slint";
import { CommandStatus } from "../../../data/lib.slint";
import { Icons } from "../../../resources/lib.slint";

export component AccessControlTab {
    in property <CommandStatus> command-status;

    callback commit-access-control();
    callback logout();

    VerticalLayout {
        spacing: StyleMetrics.layout-spacing;

        VerticalLayout { }

        VerticalLayout {
            alignment: end;

            HorizontalLayout {
                alignment: end;

                Button {
                    accessible-id: "logout-submit";
                    text: "Logout";
                    icon: Icons.logout;
                    colorize-icon: true;
                    preferred-width: 7rem;
                    enabled: !command-status.session-busy;

                    clicked => {
                        logout();
                    }
                }
            }
        }
    }
}
