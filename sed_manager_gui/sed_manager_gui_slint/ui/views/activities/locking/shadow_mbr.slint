import {
    Sector,
    CommandStatus,
    Mbr,
    Geometry,
} from "../../../data/lib.slint";
import { SectorLib } from "../../../algorithm/sector.slint";
import { Island } from "../../../widgets/island.slint";
import {
    GroupBox,
    Switch,
    Button,
    LineEdit,
    ProgressIndicator,
    StyleMetrics,
    ScrollView,
} from "std-widgets.slint";
import { PaletteExtra } from "../../../widgets/palette_extra.slint";
import { Icons } from "../../../resources/icons.slint";


export component ShadowMbrTab {
    in property <Geometry> geometry;
    in property <CommandStatus> command-status;
    in-out property <Mbr> mbr;
    private property <bool> use-file-picker: true;

    callback commit-mbr-control();
    callback write-mbr(path: string);
    callback pick-and-write-mbr();
    callback cancel-mbr-write();
    callback logout();

    VerticalLayout {
        spacing: StyleMetrics.layout-spacing;

        ScrollView {
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                alignment: start;
                spacing: StyleMetrics.layout-spacing;

                Island {
                    HorizontalLayout {
                        padding-left: 0.8rem;
                        padding-right: 0.8rem;
                        alignment: start;

                        GroupBox {
                            title: "Shadow MBR status";

                            GridLayout {
                                spacing: 0.3rem;

                                Text {
                                    min-height: 1.8rem;
                                    row: 0;
                                    col: 0;
                                    text: mbr.supported ? "Supported" : "Not supported";
                                    color: mbr.supported ? PaletteExtra.success-foreground : PaletteExtra.error-foreground;
                                }

                                Image {
                                    row: 0;
                                    col: 1;
                                    source: mbr.supported ? Icons.check : Icons.cancel;
                                    colorize: mbr.supported ? PaletteExtra.success-foreground : PaletteExtra.error-foreground;
                                    height: 1.2rem;
                                    horizontal-alignment: left;
                                }

                                Text {
                                    min-height: 1.8rem;
                                    row: 1;
                                    col: 0;
                                    text: "Capacity";
                                }

                                Text {
                                    min-height: 1.8rem;
                                    row: 2;
                                    col: 0;
                                    text: "Enabled";
                                }

                                Text {
                                    min-height: 1.8rem;
                                    row: 3;
                                    col: 0;
                                    text: "Unshadowed";
                                }

                                Text {
                                    row: 1;
                                    col: 1;
                                    text: SectorLib.to-string(mbr.size, geometry);
                                }

                                Switch {
                                    accessible-id: "mbr-enabled";
                                    row: 2;
                                    col: 1;
                                    checked <=> mbr.enabled;
                                    enabled: mbr.supported && !command-status.tper-busy && !command-status.session-busy;

                                    toggled => {
                                        commit-mbr-control()
                                    }
                                }

                                Switch {
                                    accessible-id: "mbr-done";
                                    row: 3;
                                    col: 1;
                                    checked <=> mbr.done;
                                    enabled: mbr.supported && !command-status.tper-busy && !command-status.session-busy;

                                    toggled => {
                                        commit-mbr-control()
                                    }
                                }
                            }
                        }
                    }
                }

                Island {
                    HorizontalLayout {
                        spacing: 0.8rem;
                        padding: 0.8rem;

                        path := LineEdit {
                            placeholder-text: "Enter path to PBA image";
                            visible: !use-file-picker;
                        }

                        Button {
                            width: 90px;
                            icon: use-file-picker ? Icons.file-open : Icons.upload;
                            text: !mbr.writing-in-progress ? "Upload" : "Cancel";
                            colorize-icon: true;
                            primary: true;
                            enabled: !command-status.session-busy && !command-status.tper-busy && mbr.supported;

                            clicked => {
                                if !mbr.writing-in-progress && !use-file-picker {
                                    write-mbr(path.text)
                                } else if !mbr.writing-in-progress && use-file-picker {
                                    pick-and-write-mbr()
                                } else {
                                    cancel-mbr-write()
                                }
                            }
                        }

                        Button {
                            icon: !use-file-picker ? Icons.file-open : Icons.text-fields;
                            colorize-icon: true;
                            enabled: !command-status.session-busy && !command-status.tper-busy && mbr.supported;

                            clicked => {
                                use-file-picker = !use-file-picker;
                            }
                        }
                    }
                }

                ProgressIndicator {
                    progress: mbr.upload-progress;
                    height: 1rem;
                }
            }
        }

        VerticalLayout {
            alignment: end;

            HorizontalLayout {
                alignment: end;

                Button {
                    accessible-id: "logout-submit";
                    text: "Logout";
                    icon: Icons.logout;
                    colorize-icon: true;
                    preferred-width: 7rem;

                    clicked => {
                        logout();
                    }
                }
            }
        }
    }
}
