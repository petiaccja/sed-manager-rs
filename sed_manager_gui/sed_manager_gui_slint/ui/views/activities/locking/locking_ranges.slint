import {
    ScrollView,
    CheckBox,
    Button,
    Palette,
    StyleMetrics,
} from "std-widgets.slint";
import {
    LockingRange,
    Sector,
    CommandStatus,
    Geometry,
    Alignment,
    Uid,
} from "../../../data/lib.slint";
import { SectorLib } from "../../../algorithm/sector.slint";
import { LockingRangeLib } from "../../../algorithm/locking_range.slint";
import {
    Detached,
    Cell,
    HeaderCell,
    PaletteExtra,
    CyclicColor,
    ToastQueue,
    ToastLevel,
    IconButton,
    ConfirmPopup,
} from "../../../widgets/lib.slint";
import { Icons } from "../../../resources/lib.slint";
import { MainWindowGeometry } from "../../../main_window_geometry.slint";

component LockingRangeTable {
    preferred-width: table.preferred-width;
    preferred-height: table.preferred-height;

    in property <Geometry> geometry;
    in property <Alignment> alignment;
    in-out property <[LockingRange]> locking-ranges;

    callback erase(index: int);

    viewport := ScrollView {
        GridLayout {
            Rectangle {
                background: PaletteExtra.separator.with-alpha(0.25);
                clip: true;
                border-radius: 0.6rem;
                border-width: 0.1rem;
                border-color: self.background;

                table := GridLayout {
                    spacing: 0.1rem;

                    Detached {
                        row: 0;
                        col: 0;
                        z: 2;
                        offset-x: -viewport.content-x;
                        offset-y: -viewport.content-y;
                        HeaderCell { }
                    }

                    for column[index] in [
                        "Common name",
                        "Start",
                        "End",
                        "Read locking enabled",
                        "Write locking enabled",
                        "Read locked",
                        "Write locked",
                    ]: Detached {
                        row: 0;
                        col: index + 1;
                        z: 1;
                        offset-y: -viewport.content-y;

                        HeaderCell {
                            Text {
                                text: column;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 0;
                        offset-x: -viewport.content-x;
                        z: 1;

                        HeaderCell {
                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: locking-range.name;
                                    color: CyclicColor.foreground(index);
                                    vertical-alignment: center;
                                    font-italic: LockingRangeLib.is-individual-dirty(index, locking-ranges);
                                }

                                IconButton {
                                    accessible-id: "locking-range-erase-" + index;
                                    icon-size: 1.4rem;
                                    icon: Icons.destruction;
                                    text-placement: left;
                                    enabled: !LockingRangeLib.is-individual-dirty(index, locking-ranges);

                                    clicked => {
                                        erase(index)
                                    }
                                }
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 1;

                        Cell {
                            TextInput {
                                text <=> locking-range.common-name;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 2;

                        Cell {
                            TextInput {
                                accessible-id: "locking-range-start-" + index;
                                accessible-role: text-input;
                                accessible-value: self.text;
                                text: SectorLib.to_string(locking-range.start, geometry);
                                color: SectorLib.is-valid(self.text, geometry) ? Palette.control-foreground : PaletteExtra.error-foreground;
                                vertical-alignment: center;
                                enabled: !locking-range.is-global-range;
                                opacity: !locking-range.is-global-range ? 1.0 : 0.5;

                                accepted => {
                                    if SectorLib.is-valid(self.text, geometry) {
                                        locking-range.start = SectorLib.align(SectorLib.min(SectorLib.parse(self.text, geometry), geometry.logical-sector-count), alignment);
                                        self.text = SectorLib.to-string(locking-range.start, geometry);
                                    }
                                }
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 3;

                        Cell {
                            TextInput {
                                accessible-id: "locking-range-end-" + index;
                                accessible-role: text-input;
                                accessible-value: self.text;
                                text: !locking-range.is-global-range ? SectorLib.to_string(locking-range.end, geometry) : "∞";
                                color: SectorLib.is-valid(self.text, geometry) || locking-range.is-global-range ? Palette.control-foreground : PaletteExtra.error-foreground;
                                vertical-alignment: center;
                                enabled: !locking-range.is-global-range;
                                opacity: !locking-range.is-global-range ? 1.0 : 0.5;

                                accepted => {
                                    if SectorLib.is-valid(self.text, geometry) {
                                        locking-range.end = SectorLib.align(SectorLib.min(SectorLib.parse(self.text, geometry), geometry.logical-sector-count), alignment);
                                        self.text = SectorLib.to-string(locking-range.end, geometry);
                                    }
                                }
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 4;

                        Cell {
                            horizontal-alignment: space-around;
                            CheckBox {
                                accessible-id: "locking-range-read-lock-enabled-" + index;
                                checked <=> locking-range.read-lock-enabled;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 5;

                        Cell {
                            horizontal-alignment: space-around;
                            CheckBox {
                                checked <=> locking-range.write-lock-enabled;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 6;

                        Cell {
                            horizontal-alignment: space-around;
                            CheckBox {
                                checked <=> locking-range.read-locked;
                            }
                        }
                    }

                    for locking-range[index] in locking-ranges: Detached {
                        row: index + 1;
                        col: 7;

                        Cell {
                            horizontal-alignment: space-around;
                            CheckBox {
                                checked <=> locking-range.write-locked;
                            }
                        }
                    }
                }
            }
        }
    }
}

component LockingRangeStripe inherits Rectangle {
    min-height: 2.0rem;
    background: CyclicColor.background(0);
    border-radius: 0.6rem;
    border-width: 0.2rem;
    border-color: CyclicColor.foreground(0).with-alpha(0.45);

    in property <[LockingRange]> locking-ranges;
    in property <Geometry> geometry;

    for locking-range[index] in locking-ranges: Rectangle {
        if index != 0 && locking-range.end.value - locking-range.start.value > 0ms: Rectangle {
            x: root.width * LockingRangeLib.stripe-x-normalized(index, locking-ranges, geometry);
            y: 0;
            width: root.width * LockingRangeLib.stripe-width-normalized(index, locking-ranges, geometry);
            height: root.height;

            background: CyclicColor.background(index);
            border-radius: 0.6rem;
            border-width: 0.2rem;
            border-color: CyclicColor.foreground(index).with-alpha(0.45);

            HorizontalLayout {
                width: parent.width;
                padding-left: 0.3rem;
                padding-right: 0.3rem;

                Text {
                    text: locking-range.name;
                    color: CyclicColor.foreground(index);
                    overflow: elide;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component LockingRangesTab {
    in property <Geometry> geometry;
    in property <Alignment> alignment;
    in-out property <[LockingRange]> locking-ranges;
    in property <CommandStatus> command-status;
    private property <int> erase-index;

    callback commit-locking-ranges();
    callback erase-locking-range(locking-range: Uid);
    callback logout();

    VerticalLayout {
        spacing: StyleMetrics.layout-spacing * 1.4;

        confirm-erase := ConfirmPopup {
            x: -root.absolute-position.x;
            y: -root.absolute-position.y;
            width: MainWindowGeometry.width;
            height: MainWindowGeometry.height;
            title: @tr("Erase {}?", locking-ranges[erase-index].name);
            message: "The range's data will be crypto-shredded and cannot be restored in any way.";

            confirmed => {
                erase-locking-range(locking-ranges[erase-index].uid);
            }
        }

        LockingRangeTable {
            geometry: geometry;
            alignment: alignment;
            max-height: self.preferred-height;
            locking-ranges <=> locking-ranges;

            erase(index) => {
                erase-index = index;
                confirm-erase.show();
            }
        }

        VerticalLayout {
            spacing: StyleMetrics.layout-spacing * 0.6;

            LockingRangeStripe {
                height: 3rem;
                locking-ranges: locking-ranges;
                geometry: geometry;
            }

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: SectorLib.to-string({ value: 0 }, geometry);
                    color: CyclicColor.foreground(0);
                }

                Text {
                    text: SectorLib.to-string(geometry.logical-sector-count, geometry);
                    color: CyclicColor.foreground(0);
                }
            }
        }

        VerticalLayout {
            alignment: end;

            HorizontalLayout {
                alignment: stretch;
                spacing: StyleMetrics.layout-spacing;

                Button {
                    accessible-id: "save-ranges-submit";
                    text: "Apply";
                    preferred-width: 7rem;
                    primary: true;
                    icon: Icons.check;
                    colorize-icon: true;
                    enabled: !command-status.session-busy
                        && !command-status.session-busy
                        && LockingRangeLib.is-any-dirty(locking-ranges);

                    clicked => {
                        commit-locking-ranges()
                    }
                }

                Button {
                    text: "Discard";
                    preferred-width: 7rem;
                    enabled: LockingRangeLib.is-any-dirty(locking-ranges);
                    icon: Icons.cancel;
                    colorize-icon: true;

                    clicked => {
                        if !LockingRangeLib.discard(locking-ranges) {
                            ToastQueue.push({
                                level: ToastLevel.error,
                                title: "Could not discard changes",
                                message: "You won't be able to discard your changes, but you can keep working and save them. This is a bug, please report it.",
                            })
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 100%;
                }

                Button {
                    accessible-id: "logout-submit";
                    text: "Logout";
                    icon: Icons.logout;
                    colorize-icon: true;
                    preferred-width: 7rem;
                    enabled: !command-status.session-busy;

                    clicked => {
                        logout();
                    }
                }
            }
        }
    }
}
