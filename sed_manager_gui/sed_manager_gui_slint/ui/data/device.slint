import { Status } from "status.slint";

export struct DiscoveryProperty {
    name: string,
    value: string,
}

export struct DiscoveryFeature {
    name: string,
    properties: [DiscoveryProperty],
}

export struct Discovery {
    status: Status,
    common-features: [DiscoveryFeature],
    ssc-features: [DiscoveryFeature],
}

export struct DeviceConfig {
    sid-msid-pin-differ: bool,
    locking-enabled: bool,
}

export struct Identity {
    name: string,
    serial: string,
    path: string,
    firmware: string,
    interface: string,
    security-commands: bool,
    is-removable: bool,
}

export struct StackStatus {
    connected: bool,
    com-id: int,
    com-id-ext: int,
    com-id-status: string,
}

export struct Device {
    status: Status,
    identity: Identity,
    discovery: Discovery,
    config: DeviceConfig,
    stack_status: StackStatus,
}
