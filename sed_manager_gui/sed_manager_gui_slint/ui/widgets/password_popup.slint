import { Palette, Button, StyleMetrics } from "std-widgets.slint";
import { Island } from "island.slint";
import { PaletteExtra } from "palette_extra.slint";
import { Icons } from "../resources/lib.slint";
import { PasswordForm } from "password_form.slint";

export component PasswordPopup inherits PopupWindow {
    close-policy: no-auto-close;

    in property <string> title;

    callback set(password: string);

    Rectangle {
        background: Palette.background.with-alpha(0.9);
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        alignment: center;
        preferred-width: min(root.width, max(root.width / 3, 16rem));

        HorizontalLayout {
            alignment: center;
            padding: StyleMetrics.layout-padding;

            Island {
                background: Palette.background;
                border-color: PaletteExtra.info-foreground.mix(Palette.background, 0.5);

                VerticalLayout {
                    spacing: StyleMetrics.layout-spacing;
                    padding: StyleMetrics.layout-padding;

                    Text {
                        text: title;
                        wrap: word-wrap;
                        color: PaletteExtra.info-foreground;
                    }

                    form := PasswordForm { }

                    HorizontalLayout {
                        alignment: end;
                        spacing: StyleMetrics.layout-spacing;

                        Button {
                            text: "Continue";
                            enabled: form.matches;

                            clicked => {
                                set(form.password);
                                root.close();
                            }
                        }

                        Button {
                            text: "Cancel";

                            clicked => { root.close(); }
                        }
                    }
                }
            }
        }
    }
}
